# Copy this file to .env.local and fill in real values.
# Do NOT commit your .env.local — keep secrets out of version control.

# Public Supabase URL (for local dev this is usually http://localhost:54321)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Public/anon key (used on client and public server-side operations)
NEXT_PUBLIC_SUPABASE_KEY=anon_key_here_replace_me

# Service Role key — privileged, do NOT expose to the browser or commit
NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=service_role_key_here_replace_me

# Optional additional keys used by the app
RESEND_API_KEY=
SUPABASE_JWT_SECRET=

# LLM Configuration (for CAD analysis)
# Choose one: openai or gemini
LLM_PROVIDER=openai

# OpenAI API (if using OpenAI for LLM)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Google Gemini API (if using Gemini for LLM)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-pro

# Example usage:
# 1. Copy to .env.local
# 2. Replace the placeholders with your project's values
# 3. Restart the dev server: `npm run dev`
